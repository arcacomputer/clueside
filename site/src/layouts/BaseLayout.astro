---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  socialImage?: string;
  socialImageAlt?: string;
}

const {
  title,
  description,
  canonical = 'https://clueside.com/',
  noindex = false,
  socialImage = 'https://clueside.com/assets/social-card.png',
  socialImageAlt = 'Clueside. Look twice. Upload nothing. Browser-local AI-image signals.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f0e7" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content="Clueside" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/mark.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles.css" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
